[
{"it":"ciao","en":"hi; hello; bye","pos":"interj","level":"A1","cat":"basics","ex":"Ciao, Marco! Come va?","exEn":"Hi, Marco! How's it going?","note":"Informal; used both when meeting and when leaving."},
{"it":"buongiorno","en":"good morning; good day; hello","pos":"interj","level":"A1","cat":"basics","ex":"Buongiorno, signora Rossi!","exEn":"Good morning, Mrs Rossi!","note":"Used until early afternoon; the polite greeting in shops and with strangers."},
{"it":"buonasera","en":"good evening","pos":"interj","level":"A1","cat":"basics","ex":"Buonasera a tutti!","exEn":"Good evening, everyone!"},
{"it":"buonanotte","en":"good night","pos":"interj","level":"A1","cat":"basics","ex":"Sono stanco, buonanotte!","exEn":"I'm tired, good night!","note":"Only when going to bed or leaving late at night."},
{"it":"arrivederci","en":"goodbye","pos":"interj","level":"A1","cat":"basics","ex":"Arrivederci e grazie!","exEn":"Goodbye and thank you!","note":"Polite goodbye; the very formal form is 'arrivederla'."},
{"it":"salve","en":"hello; hi","pos":"interj","level":"A1","cat":"basics","ex":"Salve, posso aiutarla?","exEn":"Hello, can I help you?","note":"Neutral greeting, between 'ciao' and 'buongiorno' in formality."},
{"it":"sì","en":"yes","pos":"adv","level":"A1","cat":"basics","ex":"Sì, sono italiano.","exEn":"Yes, I'm Italian.","note":"Note the accent: 'si' without accent is a pronoun."},
{"it":"no","en":"no","pos":"adv","level":"A1","cat":"basics","ex":"No, grazie, non ho fame.","exEn":"No, thanks, I'm not hungry."},
{"it":"grazie","en":"thank you; thanks","pos":"interj","level":"A1","cat":"basics","ex":"Grazie mille per il regalo!","exEn":"Thanks a lot for the present!","note":"'Grazie mille' = thanks a lot."},
{"it":"prego","en":"you're welcome; please (go ahead); after you","pos":"interj","level":"A1","cat":"basics","ex":"«Grazie!» «Prego!»","exEn":"\"Thank you!\" \"You're welcome!\"","note":"Also used to invite someone in or to offer something: 'Prego, si accomodi'."},
{"it":"per favore","en":"please","pos":"expr","level":"A1","cat":"basics","ex":"Un caffè, per favore.","exEn":"A coffee, please."},
{"it":"per piacere","en":"please","pos":"expr","level":"A1","cat":"basics","ex":"Chiudi la porta, per piacere.","exEn":"Close the door, please."},
{"it":"scusa","en":"sorry; excuse me (informal)","pos":"interj","level":"A1","cat":"basics","ex":"Scusa, non ho capito.","exEn":"Sorry, I didn't understand.","note":"Informal (tu). Use 'scusi' with people you address as 'Lei'."},
{"it":"scusi","en":"excuse me; sorry (formal)","pos":"interj","level":"A1","cat":"basics","ex":"Scusi, dov'è il bagno?","exEn":"Excuse me, where is the bathroom?","note":"Formal (Lei) form of 'scusa'."},
{"it":"mi dispiace","en":"I'm sorry","pos":"expr","level":"A1","cat":"basics","ex":"Mi dispiace, oggi non posso.","exEn":"I'm sorry, I can't today."},
{"it":"piacere","en":"nice to meet you; pleasure","pos":"interj","level":"A1","cat":"basics","ex":"Piacere, io sono Anna.","exEn":"Nice to meet you, I'm Anna.","note":"Short for 'piacere di conoscerti / conoscerla'."},
{"it":"come stai?","en":"how are you? (informal)","pos":"expr","level":"A1","cat":"basics","ex":"Ciao Luca, come stai?","exEn":"Hi Luca, how are you?"},
{"it":"come sta?","en":"how are you? (formal)","pos":"expr","level":"A1","cat":"basics","ex":"Buongiorno, dottore, come sta?","exEn":"Good morning, doctor, how are you?"},
{"it":"bene","en":"well; fine; good","pos":"adv","level":"A1","cat":"basics","ex":"Sto bene, grazie.","exEn":"I'm fine, thanks."},
{"it":"male","en":"badly; not well","pos":"adv","level":"A1","cat":"basics","ex":"Oggi sto male.","exEn":"I'm not feeling well today."},
{"it":"così così","en":"so-so","pos":"expr","level":"A1","cat":"basics","ex":"«Come stai?» «Così così.»","exEn":"\"How are you?\" \"So-so.\""},
{"it":"a presto","en":"see you soon","pos":"expr","level":"A1","cat":"basics","ex":"Ciao, a presto!","exEn":"Bye, see you soon!"},
{"it":"a domani","en":"see you tomorrow","pos":"expr","level":"A1","cat":"basics","ex":"Buonanotte, a domani!","exEn":"Good night, see you tomorrow!"},
{"it":"buon appetito","en":"enjoy your meal","pos":"expr","level":"A1","cat":"basics","ex":"La cena è pronta: buon appetito!","exEn":"Dinner is ready: enjoy your meal!"},
{"it":"benvenuto","en":"welcome","pos":"adj","forms":["benvenuto","benvenuta","benvenuti","benvenute"],"level":"A1","cat":"basics","ex":"Benvenuti in Italia!","exEn":"Welcome to Italy!","note":"Agrees with the person(s) welcomed: benvenuta (f), benvenuti (pl)."},
{"it":"signore","en":"Mr; sir; gentleman","pos":"noun","g":"m","pl":"signori","fem":"signora","level":"A1","cat":"basics","ex":"Buongiorno, signore! Desidera?","exEn":"Good morning, sir! What would you like?","note":"Before a name the final -e drops: signor Rossi."},
{"it":"signora","en":"Mrs; madam; lady","pos":"noun","g":"f","pl":"signore","level":"A1","cat":"basics","ex":"La signora Verdi è la mia vicina.","exEn":"Mrs Verdi is my neighbour."},
{"it":"signorina","en":"Miss; young lady","pos":"noun","g":"f","pl":"signorine","level":"A1","cat":"basics","ex":"Signorina, il suo caffè.","exEn":"Miss, your coffee."},
{"it":"va bene","en":"OK; all right; fine","pos":"expr","level":"A1","cat":"basics","ex":"Va bene, ci vediamo alle otto.","exEn":"OK, see you at eight."},
{"it":"d'accordo","en":"agreed; OK","pos":"expr","level":"A1","cat":"basics","ex":"«Andiamo al cinema?» «D'accordo!»","exEn":"\"Shall we go to the cinema?\" \"OK!\""},
{"it":"certo","en":"of course; certainly","pos":"adv","level":"A1","cat":"basics","ex":"«Posso entrare?» «Certo!»","exEn":"\"May I come in?\" \"Of course!\""},
{"it":"auguri","en":"best wishes; congratulations; happy birthday","pos":"interj","level":"A1","cat":"basics","ex":"Tanti auguri, Maria!","exEn":"Happy birthday, Maria!","note":"Plural of 'augurio'; used for birthdays, holidays and good news."},
{"it":"buona giornata","en":"have a nice day","pos":"expr","level":"A1","cat":"basics","ex":"Arrivederci, buona giornata!","exEn":"Goodbye, have a nice day!"},
{"it":"salute","en":"cheers; bless you","pos":"interj","level":"A1","cat":"basics","ex":"Alla salute! Cin cin!","exEn":"Cheers! Chin chin!","note":"Said when clinking glasses and when someone sneezes. As a noun, 'la salute' = health."},
{"it":"di niente","en":"you're welcome; don't mention it","pos":"expr","level":"A1","cat":"basics","ex":"«Grazie dell'aiuto!» «Di niente!»","exEn":"\"Thanks for the help!\" \"Don't mention it!\""},
{"it":"famiglia","en":"family","pos":"noun","g":"f","pl":"famiglie","level":"A1","cat":"people","ex":"La mia famiglia è grande.","exEn":"My family is big."},
{"it":"madre","en":"mother","pos":"noun","g":"f","pl":"madri","level":"A1","cat":"people","ex":"Mia madre si chiama Laura.","exEn":"My mother's name is Laura."},
{"it":"padre","en":"father","pos":"noun","g":"m","pl":"padri","level":"A1","cat":"people","ex":"Mio padre lavora in banca.","exEn":"My father works in a bank."},
{"it":"mamma","en":"mum; mom","pos":"noun","g":"f","pl":"mamme","level":"A1","cat":"people","ex":"La mamma cucina la pasta.","exEn":"Mum is cooking pasta.","note":"Affectionate word for 'madre'."},
{"it":"papà","en":"dad","pos":"noun","g":"m","pl":"papà","level":"A1","cat":"people","ex":"Papà, dove sono le chiavi?","exEn":"Dad, where are the keys?","note":"Invariable. Do not confuse with 'il papa' (the pope)."},
{"it":"genitore","en":"parent","pos":"noun","g":"m","pl":"genitori","level":"A1","cat":"people","ex":"I miei genitori abitano a Roma.","exEn":"My parents live in Rome.","note":"Usually plural: i genitori."},
{"it":"figlio","en":"son; child","pos":"noun","g":"m","pl":"figli","fem":"figlia","level":"A1","cat":"people","ex":"Ho due figli: un maschio e una femmina.","exEn":"I have two children: a boy and a girl."},
{"it":"fratello","en":"brother","pos":"noun","g":"m","pl":"fratelli","level":"A1","cat":"people","ex":"Mio fratello ha dieci anni.","exEn":"My brother is ten years old.","note":"'Fratelli' can mean 'brothers' or 'brothers and sisters'."},
{"it":"sorella","en":"sister","pos":"noun","g":"f","pl":"sorelle","level":"A1","cat":"people","ex":"Ho una sorella più piccola.","exEn":"I have a younger sister."},
{"it":"nonno","en":"grandfather","pos":"noun","g":"m","pl":"nonni","fem":"nonna","level":"A1","cat":"people","ex":"Il nonno legge il giornale.","exEn":"Grandpa is reading the newspaper.","note":"'I nonni' = grandparents."},
{"it":"zio","en":"uncle","pos":"noun","g":"m","pl":"zii","fem":"zia","level":"A1","cat":"people","ex":"Lo zio Paolo vive a Milano.","exEn":"Uncle Paolo lives in Milan.","note":"'Gli zii' = uncle and aunt / uncles."},
{"it":"cugino","en":"cousin","pos":"noun","g":"m","pl":"cugini","fem":"cugina","level":"A1","cat":"people","ex":"Mia cugina studia a Bologna.","exEn":"My cousin studies in Bologna."},
{"it":"marito","en":"husband","pos":"noun","g":"m","pl":"mariti","level":"A1","cat":"people","ex":"Mio marito è medico.","exEn":"My husband is a doctor."},
{"it":"moglie","en":"wife","pos":"noun","g":"f","pl":"mogli","level":"A1","cat":"people","ex":"Questa è mia moglie, Sara.","exEn":"This is my wife, Sara.","note":"Irregular plural: mogli."},
{"it":"nipote","en":"grandchild; nephew; niece","pos":"noun","g":"mf","pl":"nipoti","level":"A1","cat":"people","ex":"Ho un nipote di tre anni.","exEn":"I have a three-year-old grandson.","note":"Same word for grandson/granddaughter and nephew/niece; gender shown by the article (il/la nipote)."},
{"it":"bambino","en":"child; little boy","pos":"noun","g":"m","pl":"bambini","fem":"bambina","level":"A1","cat":"people","ex":"I bambini giocano in giardino.","exEn":"The children are playing in the garden."},
{"it":"ragazzo","en":"boy; young man; boyfriend","pos":"noun","g":"m","pl":"ragazzi","fem":"ragazza","level":"A1","cat":"people","ex":"Quel ragazzo è mio fratello.","exEn":"That boy is my brother.","note":"'Il mio ragazzo / la mia ragazza' = my boyfriend / girlfriend."},
{"it":"uomo","en":"man","pos":"noun","g":"m","pl":"uomini","level":"A1","cat":"people","ex":"Quell'uomo è mio padre.","exEn":"That man is my father.","note":"Irregular plural: uomini."},
{"it":"donna","en":"woman","pos":"noun","g":"f","pl":"donne","level":"A1","cat":"people","ex":"Una donna aspetta alla porta.","exEn":"A woman is waiting at the door."},
{"it":"amico","en":"friend","pos":"noun","g":"m","pl":"amici","fem":"amica","level":"A1","cat":"people","ex":"Marco è il mio migliore amico.","exEn":"Marco is my best friend.","note":"Plural: amici (m), amiche (f)."},
{"it":"persona","en":"person","pos":"noun","g":"f","pl":"persone","level":"A1","cat":"people","ex":"Ci sono dieci persone in classe.","exEn":"There are ten people in the class.","note":"Always feminine, even for a man."},
{"it":"gente","en":"people","pos":"noun","g":"f","pl":"-","level":"A1","cat":"people","ex":"C'è molta gente al mercato.","exEn":"There are a lot of people at the market.","note":"Singular collective noun: 'la gente è' (not 'sono')."},
{"it":"nome","en":"name; first name","pos":"noun","g":"m","pl":"nomi","level":"A1","cat":"people","ex":"Il mio nome è Giulia.","exEn":"My name is Giulia."},
{"it":"cognome","en":"surname; last name","pos":"noun","g":"m","pl":"cognomi","level":"A1","cat":"people","ex":"Come si scrive il suo cognome?","exEn":"How do you spell your surname?"},
{"it":"età","en":"age","pos":"noun","g":"f","pl":"età","level":"A1","cat":"people","ex":"Che età ha tuo figlio?","exEn":"How old is your son?","note":"Invariable. Age is expressed with 'avere': ho vent'anni."},
{"it":"indirizzo","en":"address","pos":"noun","g":"m","pl":"indirizzi","level":"A1","cat":"people","ex":"Qual è il tuo indirizzo?","exEn":"What is your address?"},
{"it":"nazionalità","en":"nationality","pos":"noun","g":"f","pl":"nazionalità","level":"A1","cat":"people","ex":"Di che nazionalità sei?","exEn":"What nationality are you?","note":"Invariable."},
{"it":"giovane","en":"young","pos":"adj","forms":["giovane","giovane","giovani","giovani"],"level":"A1","cat":"people","ex":"Mia zia è ancora giovane.","exEn":"My aunt is still young.","note":"Also a noun: i giovani = young people."},
{"it":"vecchio","en":"old","pos":"adj","forms":["vecchio","vecchia","vecchi","vecchie"],"level":"A1","cat":"people","ex":"Il nonno è vecchio ma sta bene.","exEn":"Grandpa is old but he's fine.","note":"For people, 'anziano' is more polite."},
{"it":"sposato","en":"married","pos":"adj","forms":["sposato","sposata","sposati","sposate"],"level":"A1","cat":"people","ex":"Sei sposato o single?","exEn":"Are you married or single?"},
{"it":"single","en":"single (not in a relationship)","pos":"adj","level":"A1","cat":"people","ex":"Mia sorella è single.","exEn":"My sister is single.","note":"Invariable English loanword; also a noun (un/una single)."},
{"it":"fidanzato","en":"fiancé; boyfriend","pos":"noun","g":"m","pl":"fidanzati","fem":"fidanzata","level":"A1","cat":"people","ex":"La mia fidanzata si chiama Elena.","exEn":"My girlfriend's name is Elena.","note":"Used for a steady partner, not only for an engaged couple."},
{"it":"vicino","en":"neighbour","pos":"noun","g":"m","pl":"vicini","fem":"vicina","level":"A1","cat":"people","ex":"Il mio vicino ha un cane.","exEn":"My neighbour has a dog.","note":"Often 'vicino di casa'. As an adjective/adverb it means 'near'."},
{"it":"straniero","en":"foreigner","pos":"noun","g":"m","pl":"stranieri","fem":"straniera","level":"A1","cat":"people","ex":"Molti stranieri studiano l'italiano.","exEn":"Many foreigners study Italian.","note":"Also an adjective: una lingua straniera."},
{"it":"adulto","en":"adult","pos":"noun","g":"m","pl":"adulti","fem":"adulta","level":"A1","cat":"people","ex":"Il biglietto costa dieci euro per gli adulti.","exEn":"The ticket costs ten euros for adults."},
{"it":"corpo","en":"body","pos":"noun","g":"m","pl":"corpi","level":"A1","cat":"body","ex":"Il corpo umano ha due braccia e due gambe.","exEn":"The human body has two arms and two legs."},
{"it":"testa","en":"head","pos":"noun","g":"f","pl":"teste","level":"A1","cat":"body","ex":"Mi fa male la testa.","exEn":"My head hurts."},
{"it":"faccia","en":"face","pos":"noun","g":"f","pl":"facce","level":"A1","cat":"body","ex":"Mi lavo la faccia ogni mattina.","exEn":"I wash my face every morning.","note":"'Viso' is a slightly more elegant synonym."},
{"it":"occhio","en":"eye","pos":"noun","g":"m","pl":"occhi","level":"A1","cat":"body","ex":"Lei ha gli occhi verdi.","exEn":"She has green eyes."},
{"it":"naso","en":"nose","pos":"noun","g":"m","pl":"nasi","level":"A1","cat":"body","ex":"Ho il naso chiuso.","exEn":"My nose is blocked."},
{"it":"bocca","en":"mouth","pos":"noun","g":"f","pl":"bocche","level":"A1","cat":"body","ex":"Apri la bocca, per favore.","exEn":"Open your mouth, please."},
{"it":"orecchio","en":"ear","pos":"noun","g":"m","pl":"orecchie","level":"A1","cat":"body","ex":"Mi fa male l'orecchio destro.","exEn":"My right ear hurts.","note":"Irregular plural: le orecchie (feminine); 'gli orecchi' also exists but is less common."},
{"it":"capello","en":"hair (a single hair)","pos":"noun","g":"m","pl":"capelli","level":"A1","cat":"body","ex":"Marta ha i capelli lunghi e neri.","exEn":"Marta has long black hair.","note":"Almost always plural: i capelli = hair (on the head)."},
{"it":"mano","en":"hand","pos":"noun","g":"f","pl":"mani","level":"A1","cat":"body","ex":"Lavati le mani prima di mangiare.","exEn":"Wash your hands before eating.","note":"Feminine despite ending in -o: la mano, le mani."},
{"it":"braccio","en":"arm","pos":"noun","g":"m","pl":"braccia","level":"A1","cat":"body","ex":"Ho un braccio rotto.","exEn":"I have a broken arm.","note":"Irregular plural: le braccia (feminine)."},
{"it":"gamba","en":"leg","pos":"noun","g":"f","pl":"gambe","level":"A1","cat":"body","ex":"Dopo la corsa mi fanno male le gambe.","exEn":"After the run my legs hurt."},
{"it":"piede","en":"foot","pos":"noun","g":"m","pl":"piedi","level":"A1","cat":"body","ex":"Vado a scuola a piedi.","exEn":"I go to school on foot.","note":"'A piedi' = on foot."},
{"it":"dente","en":"tooth","pos":"noun","g":"m","pl":"denti","level":"A1","cat":"body","ex":"Mi lavo i denti dopo cena.","exEn":"I brush my teeth after dinner."},
{"it":"cuore","en":"heart","pos":"noun","g":"m","pl":"cuori","level":"A1","cat":"body","ex":"Il cuore batte forte.","exEn":"The heart is beating fast."},
{"it":"pancia","en":"belly; tummy","pos":"noun","g":"f","pl":"pance","level":"A1","cat":"body","ex":"Ho mangiato troppo e mi fa male la pancia.","exEn":"I ate too much and my tummy hurts.","note":"Colloquial; 'stomaco' is stomach."},
{"it":"mal di testa","en":"headache","pos":"expr","level":"A1","cat":"body","ex":"Oggi ho mal di testa.","exEn":"I have a headache today.","note":"Pattern 'avere mal di + body part': mal di pancia, mal di gola, mal di denti."},
{"it":"dottore","en":"doctor","pos":"noun","g":"m","pl":"dottori","fem":"dottoressa","level":"A1","cat":"body","ex":"Domani vado dal dottore.","exEn":"Tomorrow I'm going to the doctor.","note":"Also a title for any university graduate. 'Medico' is the profession."},
{"it":"malato","en":"ill; sick","pos":"adj","forms":["malato","malata","malati","malate"],"level":"A1","cat":"body","ex":"Luca è malato e resta a casa.","exEn":"Luca is ill and is staying at home."},
{"it":"febbre","en":"fever; temperature","pos":"noun","g":"f","pl":"febbri","level":"A1","cat":"body","ex":"Ho la febbre alta.","exEn":"I have a high temperature.","note":"'Avere la febbre' = to have a fever."},
{"it":"medicina","en":"medicine","pos":"noun","g":"f","pl":"medicine","level":"A1","cat":"body","ex":"Prendo la medicina dopo i pasti.","exEn":"I take the medicine after meals.","note":"Also the field of study: studiare medicina."},
{"it":"felice","en":"happy","pos":"adj","forms":["felice","felice","felici","felici"],"level":"A1","cat":"emotions","ex":"Oggi sono molto felice.","exEn":"Today I'm very happy."},
{"it":"contento","en":"glad; happy; pleased","pos":"adj","forms":["contento","contenta","contenti","contente"],"level":"A1","cat":"emotions","ex":"Sono contenta di vederti.","exEn":"I'm glad to see you.","note":"'Contento di' + infinitive or noun."},
{"it":"triste","en":"sad","pos":"adj","forms":["triste","triste","tristi","tristi"],"level":"A1","cat":"emotions","ex":"Perché sei triste?","exEn":"Why are you sad?"},
{"it":"stanco","en":"tired","pos":"adj","forms":["stanco","stanca","stanchi","stanche"],"level":"A1","cat":"emotions","ex":"Dopo il lavoro sono sempre stanco.","exEn":"After work I'm always tired.","note":"Plural with -h-: stanchi, stanche."},
{"it":"arrabbiato","en":"angry","pos":"adj","forms":["arrabbiato","arrabbiata","arrabbiati","arrabbiate"],"level":"A1","cat":"emotions","ex":"La mamma è arrabbiata con me.","exEn":"Mum is angry with me.","note":"'Arrabbiato con qualcuno' = angry with someone."},
{"it":"nervoso","en":"nervous; irritable","pos":"adj","forms":["nervoso","nervosa","nervosi","nervose"],"level":"A1","cat":"emotions","ex":"Prima dell'esame sono nervoso.","exEn":"Before the exam I'm nervous.","note":"Often means 'irritable, on edge' rather than 'anxious'."},
{"it":"tranquillo","en":"calm; quiet; relaxed","pos":"adj","forms":["tranquillo","tranquilla","tranquilli","tranquille"],"level":"A1","cat":"emotions","ex":"Stai tranquillo, va tutto bene.","exEn":"Stay calm, everything's fine.","note":"'Tranquillo!' alone = don't worry."},
{"it":"simpatico","en":"nice; likeable; friendly","pos":"adj","forms":["simpatico","simpatica","simpatici","simpatiche"],"level":"A1","cat":"emotions","ex":"Il tuo amico è molto simpatico.","exEn":"Your friend is very nice.","note":"False friend: it does not mean 'sympathetic'."},
{"it":"antipatico","en":"unpleasant; unfriendly","pos":"adj","forms":["antipatico","antipatica","antipatici","antipatiche"],"level":"A1","cat":"emotions","ex":"Quel cameriere è antipatico.","exEn":"That waiter is unfriendly."},
{"it":"gentile","en":"kind; polite","pos":"adj","forms":["gentile","gentile","gentili","gentili"],"level":"A1","cat":"emotions","ex":"Grazie, sei molto gentile.","exEn":"Thank you, you're very kind."},
{"it":"allegro","en":"cheerful; merry","pos":"adj","forms":["allegro","allegra","allegri","allegre"],"level":"A1","cat":"emotions","ex":"I bambini sono sempre allegri.","exEn":"Children are always cheerful."},
{"it":"timido","en":"shy","pos":"adj","forms":["timido","timida","timidi","timide"],"level":"A1","cat":"emotions","ex":"Mia figlia è un po' timida.","exEn":"My daughter is a bit shy."},
{"it":"innamorato","en":"in love","pos":"adj","forms":["innamorato","innamorata","innamorati","innamorate"],"level":"A1","cat":"emotions","ex":"Paolo è innamorato di Chiara.","exEn":"Paolo is in love with Chiara.","note":"'Innamorato di qualcuno' = in love with someone."},
{"it":"amore","en":"love","pos":"noun","g":"m","pl":"amori","level":"A1","cat":"emotions","ex":"L'amore è importante nella vita.","exEn":"Love is important in life.","note":"'Amore!' is also a term of endearment (darling)."},
{"it":"paura","en":"fear","pos":"noun","g":"f","pl":"paure","level":"A1","cat":"emotions","ex":"Ho paura dei cani.","exEn":"I'm afraid of dogs.","note":"'Avere paura di' = to be afraid of."},
{"it":"cibo","en":"food","pos":"noun","g":"m","pl":"cibi","level":"A1","cat":"food","ex":"Il cibo italiano è buonissimo.","exEn":"Italian food is delicious."},
{"it":"pane","en":"bread","pos":"noun","g":"m","pl":"pani","level":"A1","cat":"food","ex":"Compro il pane ogni mattina.","exEn":"I buy bread every morning.","note":"Usually singular; 'un pane' = a loaf."},
{"it":"pasta","en":"pasta; pastry","pos":"noun","g":"f","pl":"paste","level":"A1","cat":"food","ex":"A pranzo mangiamo la pasta.","exEn":"For lunch we eat pasta.","note":"'Una pasta' (at the bar) is a small pastry."},
{"it":"pizza","en":"pizza","pos":"noun","g":"f","pl":"pizze","level":"A1","cat":"food","ex":"Stasera mangiamo una pizza.","exEn":"Tonight we're having a pizza."},
{"it":"riso","en":"rice","pos":"noun","g":"m","pl":"-","level":"A1","cat":"food","ex":"Il riso è pronto in venti minuti.","exEn":"The rice is ready in twenty minutes.","note":"Also 'riso' = laughter (plural 'risa')."}
]
