[
{"it":"lunedì","en":"Monday","pos":"noun","g":"m","pl":"lunedì","level":"A1","cat":"time","ex":"Il lunedì comincio a lavorare alle otto.","exEn":"On Mondays I start work at eight.","note":"Days are lowercase and invariable. 'il lunedì' = on Mondays (every Monday); 'lunedì' alone = this/next Monday."},
{"it":"martedì","en":"Tuesday","pos":"noun","g":"m","pl":"martedì","level":"A1","cat":"time","ex":"Il martedì ho lezione di italiano.","exEn":"On Tuesdays I have an Italian lesson."},
{"it":"mercoledì","en":"Wednesday","pos":"noun","g":"m","pl":"mercoledì","level":"A1","cat":"time","ex":"Mercoledì vado dal dentista.","exEn":"On Wednesday I am going to the dentist."},
{"it":"giovedì","en":"Thursday","pos":"noun","g":"m","pl":"giovedì","level":"A1","cat":"time","ex":"Giovedì sera andiamo al cinema.","exEn":"On Thursday evening we are going to the cinema."},
{"it":"venerdì","en":"Friday","pos":"noun","g":"m","pl":"venerdì","level":"A1","cat":"time","ex":"Il venerdì finisco presto.","exEn":"On Fridays I finish early."},
{"it":"sabato","en":"Saturday","pos":"noun","g":"m","pl":"sabati","level":"A1","cat":"time","ex":"Il sabato non lavoro.","exEn":"On Saturdays I don't work."},
{"it":"domenica","en":"Sunday","pos":"noun","g":"f","pl":"domeniche","level":"A1","cat":"time","ex":"La domenica pranzo con la famiglia.","exEn":"On Sundays I have lunch with my family.","note":"The only feminine day of the week."},
{"it":"gennaio","en":"January","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A gennaio fa molto freddo.","exEn":"In January it is very cold.","note":"Months are lowercase in Italian. 'a gennaio' / 'in gennaio' = in January."},
{"it":"febbraio","en":"February","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"Il mio compleanno è a febbraio.","exEn":"My birthday is in February."},
{"it":"marzo","en":"March","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A marzo comincia la primavera.","exEn":"In March spring begins."},
{"it":"aprile","en":"April","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"Ad aprile piove spesso.","exEn":"In April it often rains."},
{"it":"maggio","en":"May","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A maggio ci sono molti fiori.","exEn":"In May there are lots of flowers."},
{"it":"giugno","en":"June","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"La scuola finisce a giugno.","exEn":"School ends in June."},
{"it":"luglio","en":"July","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A luglio fa molto caldo.","exEn":"In July it is very hot."},
{"it":"agosto","en":"August","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"Ad agosto gli italiani vanno in vacanza.","exEn":"In August Italians go on holiday."},
{"it":"settembre","en":"September","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A settembre torno a scuola.","exEn":"In September I go back to school."},
{"it":"ottobre","en":"October","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A ottobre cadono le foglie.","exEn":"In October the leaves fall."},
{"it":"novembre","en":"November","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"A novembre piove molto.","exEn":"In November it rains a lot."},
{"it":"dicembre","en":"December","pos":"noun","g":"m","pl":"-","level":"A1","cat":"time","ex":"Natale è il 25 dicembre.","exEn":"Christmas is on 25 December."},
{"it":"primavera","en":"spring","pos":"noun","g":"f","pl":"primavere","level":"A1","cat":"time","ex":"In primavera ci sono tanti fiori.","exEn":"In spring there are lots of flowers."},
{"it":"estate","en":"summer","pos":"noun","g":"f","pl":"estati","level":"A1","cat":"time","ex":"In estate andiamo al mare.","exEn":"In summer we go to the seaside.","note":"'d'estate' / 'in estate' = in summer."},
{"it":"autunno","en":"autumn; fall","pos":"noun","g":"m","pl":"autunni","level":"A1","cat":"time","ex":"In autunno le foglie sono gialle e rosse.","exEn":"In autumn the leaves are yellow and red."},
{"it":"inverno","en":"winter","pos":"noun","g":"m","pl":"inverni","level":"A1","cat":"time","ex":"In inverno nevica in montagna.","exEn":"In winter it snows in the mountains.","note":"'d'inverno' / 'in inverno' = in winter."},
{"it":"mattina","en":"morning","pos":"noun","g":"f","pl":"mattine","level":"A1","cat":"time","ex":"La mattina bevo un caffè.","exEn":"In the morning I drink a coffee.","note":"Also 'mattino' (m). 'di mattina' = in the morning; 'stamattina' = this morning."},
{"it":"pomeriggio","en":"afternoon","pos":"noun","g":"m","pl":"pomeriggi","level":"A1","cat":"time","ex":"Nel pomeriggio studio.","exEn":"In the afternoon I study.","note":"'di pomeriggio' / 'nel pomeriggio' = in the afternoon."},
{"it":"sera","en":"evening","pos":"noun","g":"f","pl":"sere","level":"A1","cat":"time","ex":"La sera guardo la TV.","exEn":"In the evening I watch TV.","note":"'di sera' = in the evening; 'Buonasera' = good evening."},
{"it":"notte","en":"night","pos":"noun","g":"f","pl":"notti","level":"A1","cat":"time","ex":"Di notte dormo.","exEn":"At night I sleep.","note":"'di notte' = at night; 'Buonanotte' = good night."},
{"it":"stasera","en":"this evening; tonight","pos":"adv","level":"A1","cat":"time","ex":"Stasera mangiamo la pizza.","exEn":"Tonight we are eating pizza.","note":"From 'questa sera'. 'stanotte' = tonight (at night), 'stamattina' = this morning."},
{"it":"oggi","en":"today","pos":"adv","level":"A1","cat":"time","ex":"Oggi è lunedì.","exEn":"Today is Monday."},
{"it":"domani","en":"tomorrow","pos":"adv","level":"A1","cat":"time","ex":"Domani non lavoro.","exEn":"Tomorrow I am not working.","note":"'dopodomani' = the day after tomorrow. 'A domani!' = see you tomorrow."},
{"it":"ieri","en":"yesterday","pos":"adv","level":"A1","cat":"time","ex":"Ieri ho mangiato al ristorante.","exEn":"Yesterday I ate at a restaurant.","note":"'l'altro ieri' = the day before yesterday."},
{"it":"adesso","en":"now","pos":"adv","level":"A1","cat":"time","ex":"Adesso sono a casa.","exEn":"Now I am at home.","note":"Synonym: 'ora'."},
{"it":"sempre","en":"always","pos":"adv","level":"A1","cat":"time","ex":"Bevo sempre il caffè la mattina.","exEn":"I always drink coffee in the morning."},
{"it":"mai","en":"never; ever","pos":"adv","level":"A1","cat":"time","ex":"Non mangio mai la carne.","exEn":"I never eat meat.","note":"With a verb Italian uses the double negative: non ... mai."},
{"it":"spesso","en":"often","pos":"adv","level":"A1","cat":"time","ex":"Vado spesso al cinema.","exEn":"I often go to the cinema."},
{"it":"ora","en":"hour; time (of day)","pos":"noun","g":"f","pl":"ore","level":"A1","cat":"time","ex":"Che ora è?","exEn":"What time is it?","note":"'Che ore sono?' is equally common. Also an adverb meaning 'now' (= adesso)."},
{"it":"giorno","en":"day","pos":"noun","g":"m","pl":"giorni","level":"A1","cat":"time","ex":"Che giorno è oggi?","exEn":"What day is it today?","note":"'Buongiorno' = good morning; 'tutti i giorni' = every day."},
{"it":"settimana","en":"week","pos":"noun","g":"f","pl":"settimane","level":"A1","cat":"time","ex":"Vado in piscina due volte alla settimana.","exEn":"I go to the pool twice a week."},
{"it":"fine settimana","en":"weekend","pos":"noun","g":"m","pl":"fine settimana","level":"A1","cat":"time","ex":"Cosa fai questo fine settimana?","exEn":"What are you doing this weekend?","note":"Invariable; 'il weekend' is also very common."},
{"it":"mese","en":"month","pos":"noun","g":"m","pl":"mesi","level":"A1","cat":"time","ex":"Un anno ha dodici mesi.","exEn":"A year has twelve months."},
{"it":"anno","en":"year","pos":"noun","g":"m","pl":"anni","level":"A1","cat":"time","ex":"Ho vent'anni.","exEn":"I am twenty years old.","note":"Age is expressed with 'avere': ho 20 anni. 'Buon anno!' = Happy New Year."},
{"it":"presto","en":"early; soon","pos":"adv","level":"A1","cat":"time","ex":"La mattina mi alzo presto.","exEn":"In the morning I get up early.","note":"'A presto!' = see you soon."},
{"it":"tardi","en":"late","pos":"adv","level":"A1","cat":"time","ex":"È tardi, vado a letto.","exEn":"It's late, I'm going to bed.","note":"'A più tardi!' = see you later. 'in ritardo' = late (behind schedule)."},
{"it":"zero","en":"zero","pos":"num","level":"A1","cat":"numbers","ex":"Il mio numero finisce con zero.","exEn":"My number ends in zero."},
{"it":"uno","en":"one","pos":"num","level":"A1","cat":"numbers","ex":"Uno più uno fa due.","exEn":"One plus one makes two.","note":"Before a noun it behaves like the indefinite article: un libro, una casa, uno zaino."},
{"it":"due","en":"two","pos":"num","level":"A1","cat":"numbers","ex":"Ho due gatti.","exEn":"I have two cats."},
{"it":"tre","en":"three","pos":"num","level":"A1","cat":"numbers","ex":"Il corso dura tre mesi.","exEn":"The course lasts three months."},
{"it":"quattro","en":"four","pos":"num","level":"A1","cat":"numbers","ex":"Siamo in quattro a cena.","exEn":"There are four of us for dinner."},
{"it":"cinque","en":"five","pos":"num","level":"A1","cat":"numbers","ex":"La lezione finisce alle cinque.","exEn":"The lesson ends at five."},
{"it":"sei","en":"six","pos":"num","level":"A1","cat":"numbers","ex":"Mi alzo alle sei.","exEn":"I get up at six.","note":"Same form as 'sei' = you are (tu sei)."},
{"it":"sette","en":"seven","pos":"num","level":"A1","cat":"numbers","ex":"La settimana ha sette giorni.","exEn":"The week has seven days."},
{"it":"otto","en":"eight","pos":"num","level":"A1","cat":"numbers","ex":"Il treno parte alle otto.","exEn":"The train leaves at eight."},
{"it":"nove","en":"nine","pos":"num","level":"A1","cat":"numbers","ex":"Il negozio apre alle nove.","exEn":"The shop opens at nine."},
{"it":"dieci","en":"ten","pos":"num","level":"A1","cat":"numbers","ex":"Un caffè costa un euro e dieci.","exEn":"A coffee costs one euro ten."},
{"it":"undici","en":"eleven","pos":"num","level":"A1","cat":"numbers","ex":"Mio fratello ha undici anni.","exEn":"My brother is eleven years old."},
{"it":"dodici","en":"twelve","pos":"num","level":"A1","cat":"numbers","ex":"Pranzo alle dodici e mezzo.","exEn":"I have lunch at half past twelve."},
{"it":"tredici","en":"thirteen","pos":"num","level":"A1","cat":"numbers","ex":"Abito al numero tredici.","exEn":"I live at number thirteen."},
{"it":"quattordici","en":"fourteen","pos":"num","level":"A1","cat":"numbers","ex":"Mia sorella ha quattordici anni.","exEn":"My sister is fourteen."},
{"it":"quindici","en":"fifteen","pos":"num","level":"A1","cat":"numbers","ex":"Il film comincia tra quindici minuti.","exEn":"The film starts in fifteen minutes.","note":"'quindici giorni' = two weeks, a fortnight."},
{"it":"sedici","en":"sixteen","pos":"num","level":"A1","cat":"numbers","ex":"Il biglietto costa sedici euro.","exEn":"The ticket costs sixteen euros."},
{"it":"diciassette","en":"seventeen","pos":"num","level":"A1","cat":"numbers","ex":"Ho diciassette anni.","exEn":"I am seventeen years old."},
{"it":"diciotto","en":"eighteen","pos":"num","level":"A1","cat":"numbers","ex":"A diciotto anni si può votare.","exEn":"At eighteen you can vote."},
{"it":"diciannove","en":"nineteen","pos":"num","level":"A1","cat":"numbers","ex":"Il pranzo costa diciannove euro.","exEn":"Lunch costs nineteen euros."},
{"it":"venti","en":"twenty","pos":"num","level":"A1","cat":"numbers","ex":"Ho venti euro nel portafoglio.","exEn":"I have twenty euros in my wallet.","note":"21 = ventuno, 28 = ventotto (the final vowel drops before uno and otto). 23 = ventitré."},
{"it":"trenta","en":"thirty","pos":"num","level":"A1","cat":"numbers","ex":"Il libro costa trenta euro.","exEn":"The book costs thirty euros.","note":"Before 'anni' it usually elides: trent'anni."},
{"it":"quaranta","en":"forty","pos":"num","level":"A1","cat":"numbers","ex":"Lavoro quaranta ore alla settimana.","exEn":"I work forty hours a week."},
{"it":"cinquanta","en":"fifty","pos":"num","level":"A1","cat":"numbers","ex":"La camera costa cinquanta euro a notte.","exEn":"The room costs fifty euros a night."},
{"it":"sessanta","en":"sixty","pos":"num","level":"A1","cat":"numbers","ex":"Un'ora ha sessanta minuti.","exEn":"An hour has sixty minutes."},
{"it":"settanta","en":"seventy","pos":"num","level":"A1","cat":"numbers","ex":"Il vestito costa settanta euro.","exEn":"The dress costs seventy euros."},
{"it":"ottanta","en":"eighty","pos":"num","level":"A1","cat":"numbers","ex":"Il paese è a ottanta chilometri da Roma.","exEn":"The village is eighty kilometres from Rome."},
{"it":"novanta","en":"ninety","pos":"num","level":"A1","cat":"numbers","ex":"Le scarpe costano novanta euro.","exEn":"The shoes cost ninety euros."},
{"it":"cento","en":"a hundred; one hundred","pos":"num","level":"A1","cat":"numbers","ex":"Cento euro sono troppi.","exEn":"A hundred euros is too much.","note":"Invariable: duecento, trecento. 'per cento' = per cent."},
{"it":"mille","en":"a thousand; one thousand","pos":"num","level":"A1","cat":"numbers","ex":"Questo telefono costa mille euro.","exEn":"This phone costs a thousand euros.","note":"Plural is 'mila': duemila, tremila. 'Grazie mille!' = thanks a lot."},
{"it":"primo","en":"first","pos":"adj","forms":["primo","prima","primi","prime"],"level":"A1","cat":"numbers","ex":"È la prima volta che vengo in Italia.","exEn":"It's the first time I have come to Italy.","note":"'il primo' also = the first course of a meal (pasta, risotto)."},
{"it":"secondo","en":"second","pos":"adj","forms":["secondo","seconda","secondi","seconde"],"level":"A1","cat":"numbers","ex":"Abito al secondo piano.","exEn":"I live on the second floor.","note":"'il secondo' also = the main course (meat or fish). 'secondo me' = in my opinion."},
{"it":"terzo","en":"third","pos":"adj","forms":["terzo","terza","terzi","terze"],"level":"A1","cat":"numbers","ex":"È la terza porta a sinistra.","exEn":"It's the third door on the left."},
{"it":"molto","en":"a lot of; many; much; very","pos":"adj","forms":["molto","molta","molti","molte"],"level":"A1","cat":"numbers","ex":"Ho molti amici in Italia.","exEn":"I have many friends in Italy.","note":"Agrees with the noun as an adjective (molti amici, molta gente) but is invariable as an adverb (molto bella, molto bene)."},
{"it":"poco","en":"little; few; not much","pos":"adj","forms":["poco","poca","pochi","poche"],"level":"A1","cat":"numbers","ex":"Ho poco tempo.","exEn":"I have little time.","note":"Plural with h: pochi soldi, poche persone. As an adverb it is invariable; un po' = a bit."},
{"it":"tanto","en":"a lot of; so much; so many","pos":"adj","forms":["tanto","tanta","tanti","tante"],"level":"A1","cat":"numbers","ex":"C'è tanta gente in piazza.","exEn":"There are lots of people in the square.","note":"Similar to 'molto'. 'Tanti auguri!' = best wishes / happy birthday."},
{"it":"colore","en":"colour","pos":"noun","g":"m","pl":"colori","level":"A1","cat":"colors","ex":"Qual è il tuo colore preferito?","exEn":"What is your favourite colour?","note":"'Di che colore è?' = What colour is it?"},
{"it":"rosso","en":"red","pos":"adj","forms":["rosso","rossa","rossi","rosse"],"level":"A1","cat":"colors","ex":"La macchina è rossa.","exEn":"The car is red."},
{"it":"giallo","en":"yellow","pos":"adj","forms":["giallo","gialla","gialli","gialle"],"level":"A1","cat":"colors","ex":"Il sole è giallo.","exEn":"The sun is yellow.","note":"'un giallo' = a detective novel or film."},
{"it":"verde","en":"green","pos":"adj","forms":["verde","verde","verdi","verdi"],"level":"A1","cat":"colors","ex":"Ho gli occhi verdi.","exEn":"I have green eyes."},
{"it":"blu","en":"blue; dark blue","pos":"adj","level":"A1","cat":"colors","ex":"Porto i jeans blu.","exEn":"I am wearing blue jeans.","note":"Invariable: la giacca blu, le giacche blu. For light or sky blue use 'azzurro'."},
{"it":"azzurro","en":"light blue; sky blue","pos":"adj","forms":["azzurro","azzurra","azzurri","azzurre"],"level":"A1","cat":"colors","ex":"Il cielo è azzurro.","exEn":"The sky is blue.","note":"'gli Azzurri' = Italy's national sports teams."},
{"it":"bianco","en":"white","pos":"adj","forms":["bianco","bianca","bianchi","bianche"],"level":"A1","cat":"colors","ex":"Il vino bianco è freddo.","exEn":"The white wine is cold.","note":"Plural with h: bianchi, bianche."},
{"it":"nero","en":"black","pos":"adj","forms":["nero","nera","neri","nere"],"level":"A1","cat":"colors","ex":"Ho un gatto nero.","exEn":"I have a black cat."},
{"it":"grigio","en":"grey","pos":"adj","forms":["grigio","grigia","grigi","grigie"],"level":"A1","cat":"colors","ex":"Oggi il cielo è grigio.","exEn":"Today the sky is grey."},
{"it":"marrone","en":"brown","pos":"adj","forms":["marrone","marrone","marroni","marroni"],"level":"A1","cat":"colors","ex":"Le scarpe sono marroni.","exEn":"The shoes are brown.","note":"Often left invariable in everyday speech (scarpe marrone). For brown hair or eyes use 'castano'."},
{"it":"rosa","en":"pink","pos":"adj","level":"A1","cat":"colors","ex":"La mia camera è rosa.","exEn":"My bedroom is pink.","note":"Invariable: fiori rosa. Also a noun: la rosa = rose."},
{"it":"arancione","en":"orange (colour)","pos":"adj","forms":["arancione","arancione","arancioni","arancioni"],"level":"A1","cat":"colors","ex":"Ho una maglietta arancione.","exEn":"I have an orange T-shirt.","note":"The fruit is 'arancia' (f). Sometimes used as invariable."},
{"it":"viola","en":"purple; violet","pos":"adj","level":"A1","cat":"colors","ex":"I fiori sono viola.","exEn":"The flowers are purple.","note":"Invariable: una borsa viola, scarpe viola."},
{"it":"chiaro","en":"light (colour); clear","pos":"adj","forms":["chiaro","chiara","chiari","chiare"],"level":"A1","cat":"colors","ex":"Mi piace il verde chiaro.","exEn":"I like light green.","note":"Opposite: 'scuro' (dark). Compound colours are invariable: scarpe verde chiaro, giacca blu scuro. Also 'clear': è chiaro? = is it clear?"},
{"it":"grande","en":"big; large; great","pos":"adj","forms":["grande","grande","grandi","grandi"],"level":"A1","cat":"colors","ex":"Casa mia è grande.","exEn":"My house is big.","note":"Before a singular noun it can shorten to 'gran': un gran giorno."},
{"it":"piccolo","en":"small; little","pos":"adj","forms":["piccolo","piccola","piccoli","piccole"],"level":"A1","cat":"colors","ex":"Ho una macchina piccola.","exEn":"I have a small car."},
{"it":"lungo","en":"long","pos":"adj","forms":["lungo","lunga","lunghi","lunghe"],"level":"A1","cat":"colors","ex":"Maria ha i capelli lunghi.","exEn":"Maria has long hair.","note":"Plural with h: lunghi, lunghe."},
{"it":"corto","en":"short","pos":"adj","forms":["corto","corta","corti","corte"],"level":"A1","cat":"colors","ex":"Marco ha i capelli corti.","exEn":"Marco has short hair.","note":"For people's height use 'basso', not 'corto'."},
{"it":"quadrato","en":"square","pos":"noun","g":"m","pl":"quadrati","level":"A1","cat":"colors","ex":"La finestra è un quadrato.","exEn":"The window is a square.","note":"Also an adjective: un tavolo quadrato."},
{"it":"rotondo","en":"round","pos":"adj","forms":["rotondo","rotonda","rotondi","rotonde"],"level":"A1","cat":"colors","ex":"Il tavolo è rotondo.","exEn":"The table is round.","note":"'cerchio' = circle (noun)."},
{"it":"musica","en":"music","pos":"noun","g":"f","pl":"musiche","level":"A1","cat":"arts","ex":"Ascolto la musica in macchina.","exEn":"I listen to music in the car."},
{"it":"canzone","en":"song","pos":"noun","g":"f","pl":"canzoni","level":"A1","cat":"arts","ex":"Questa canzone è bellissima.","exEn":"This song is beautiful."},
{"it":"teatro","en":"theatre","pos":"noun","g":"m","pl":"teatri","level":"A1","cat":"arts","ex":"Sabato andiamo a teatro.","exEn":"On Saturday we are going to the theatre.","note":"'a teatro' (no article) = to the theatre."},
{"it":"arte","en":"art","pos":"noun","g":"f","pl":"arti","level":"A1","cat":"arts","ex":"Mi piace l'arte italiana.","exEn":"I like Italian art."},
{"it":"concerto","en":"concert","pos":"noun","g":"m","pl":"concerti","level":"A1","cat":"arts","ex":"Stasera c'è un concerto in piazza.","exEn":"Tonight there is a concert in the square."},
{"it":"foto","en":"photo","pos":"noun","g":"f","pl":"foto","level":"A1","cat":"arts","ex":"Faccio una foto al Colosseo.","exEn":"I take a photo of the Colosseum.","note":"Invariable and feminine (short for fotografia): la foto, le foto. 'fare una foto' = to take a photo."},
{"it":"cantante","en":"singer","pos":"noun","g":"mf","pl":"cantanti","level":"A1","cat":"arts","ex":"Il mio cantante preferito è italiano.","exEn":"My favourite singer is Italian.","note":"il/la cantante."},
{"it":"attore","en":"actor","pos":"noun","g":"m","pl":"attori","fem":"attrice","level":"A1","cat":"arts","ex":"Quell'attore è molto famoso.","exEn":"That actor is very famous.","note":"Feminine: attrice, pl. attrici."}
]
