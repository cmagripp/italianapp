  "findings": [
    {
      "id": "v:gioire",
      "status": "verified reference defect; pending repair",
      "detail": "The reference synthesizes present participle gioente. Treccani explicitly marks the present participle defective; retain gioito/gioendo and core forms but suppress this fabricated display.",
      "source": "https://www.treccani.it/vocabolario/gioire/"
    },
    {
      "id": "v:imperversare",
      "status": "verified English time-span defect; pending repair",
      "detail": "Frame0 da stamattina/since this morning combines with simple rages/is raging and used to rage. The first needs has been raging in English; the generic habitual past is incoherent with this one ongoing interval. Revise the frame or provide explicit tense-sensitive translations, preserving saved scenes."
    },
    {
      "id": "v:impugnare",
      "status": "verified qualification/editorial candidate; pending repair",
      "detail": "The dictionary sentence presents a universal dismissal deadline/finality assertion. Art6 is more specific about written notification and additional procedure; teach a concrete individual appeal without asserting a universal legal rule. Ordinary lexical examples and selected challenge meaning otherwise retained.",
      "source": "https://www.normattiva.it/uri-res/N2Ls?urn%3Anir%3Astato%3Alegge%3A1966-07-15%3B604~art6="
    },
    {
      "id": "v:inasprire",
      "status": "English collocation improvement candidate",
      "detail": "Frame0 gives tighten penalties; make penalties harsher/increase penalties or toughen penalties is clearer. Other tighten access rules/border checks frames are appropriate; use frame-specific English instead of replacing all."
    },
    {
      "id": "v:incentivare",
      "status": "verified explanatory relation correction candidate",
      "detail": "Usage claims incentivare is broader than incoraggiare because it implies concrete rewards. This rationale describes a more specific sense, not a broader one. Rephrase around concrete help/measures without a universal only-reward claim.",
      "source": "https://www.treccani.it/vocabolario/incentivare/"
    },
    {
      "id": "v:incombere",
      "status": "keep supported defectivity; minor translation/editorial candidates",
      "detail": "Treccani confirms absence of past participle and compound tenses: retain missing forms. Policy election singular vs Italian le elezioni is potentially idiomatic translation of one election, not automatically number error. Dictionary burden-of-proof sentence can be a concrete example rather than universal legal assertion.",
      "source": "https://www.treccani.it/vocabolario/incombere/"
    }
  ]
}
